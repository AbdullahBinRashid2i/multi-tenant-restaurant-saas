# ── Local development ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

PORT=5000

# MongoDB Connection URI (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017/restaurant_saas

# JWT Secret — use a long random string in production
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL — used for CORS origin and Socket.io allowed origins.
FRONTEND_URL=http://localhost:3000

# Super Admin seed credentials (used only on first startup if no admin exists)
SUPERADMIN_EMAIL=superadmin@platform.com
SUPERADMIN_PASSWORD=admin123

# ── Vercel production deployment ──────────────────────────────────────────────
# In the Vercel dashboard go to:
#   Project → Settings → Environment Variables
#
# Set these for the backend service:
#
#   MONGODB_URI      → your Atlas connection string
#                      mongodb+srv://<user>:<pass>@cluster0.mongodb.net/restaurant_saas?...
#
#   JWT_SECRET       → a long random secret (generate with: openssl rand -hex 32)
#
#   FRONTEND_URL     → your Vercel project URL, e.g. https://your-project.vercel.app
#                      This is used for CORS and Socket.io origin validation.
#
#   SUPERADMIN_EMAIL → superadmin@platform.com  (or your preferred email)
#   SUPERADMIN_PASSWORD → admin123              (change in production!)
#
# PORT is set automatically by Vercel — do not set it yourself.
