# Server Port
PORT=5000

# MongoDB Connection URI (Atlas or Local)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurant_saas?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/restaurant_saas

# JWT Secret Key (use a long random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL — used for CORS origin and Socket.io allowed origins.
# Local:  http://localhost:3000
# Vercel: https://your-project.vercel.app  (your actual Vercel domain)
FRONTEND_URL=http://localhost:3000

# Super Admin Seed Credentials (Optional — used only on first startup)
SUPERADMIN_EMAIL=superadmin@platform.com
SUPERADMIN_PASSWORD=admin123
