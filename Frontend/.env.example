# ── Local development ─────────────────────────────────────────────────────────
# Point to the backend dev server running on port 5000.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Vercel deployment ─────────────────────────────────────────────────────────
# Set this to an EMPTY STRING ("") in your Vercel project environment variables.
# All /api/* and /uploads/* requests will then go to the same origin and be
# routed to the backend service by the top-level rewrites in vercel.json.
#
# In the Vercel dashboard: Settings → Environment Variables → NEXT_PUBLIC_API_URL → ""
