# ── Local development ─────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
#
# NEXT_PUBLIC_API_URL points to your local Express backend.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Vercel production deployment ──────────────────────────────────────────────
# In the Vercel dashboard go to:
#   Project → Settings → Environment Variables
#
# Add this variable with an EMPTY VALUE (leave the value field blank):
#   Name : NEXT_PUBLIC_API_URL
#   Value: (empty string — do not type anything)
#
# Why empty? The Next.js bundle bakes NEXT_PUBLIC_* at build time.
# An empty string makes API_BASE_URL = "" so:
#   • Axios baseURL becomes "/api"       → rewrite → backend service
#   • Image URLs become "/uploads/..."  → rewrite → backend service
#   • Socket.io auto-connects to same origin → rewrite → backend service
#
# Using ?? (not ||) in api.js and socket.js ensures the empty string is
# preserved and not overridden by the localhost fallback.
